{
  "name": "king-domfy-web-essentials",
  "version": "2.0.0",
  "description": "Projeto conceitual de streaming musical inspirado no Spotify.",
  "main": "index.js",
  "scripts": {
    "dev": "live-server --port=5500 --open=/index.html",
    "clean": "rimraf dist",
    "create-dirs": "mkdir -p dist/src/css && mkdir -p dist/src/js && mkdir -p dist/src/assets/imagens && mkdir -p dist/src/assets/media && mkdir -p dist/vendor && mkdir -p dist/pages",
    "copy:assets": "cpx \"src/assets/imagens/**/*\" \"dist/src/assets/imagens\" && cpx \"src/assets/media/**/*\" \"dist/src/assets/media\" && cpx \"vendor/**/*\" \"dist/vendor\"",
    "copy:js": "cpx \"src/js/**/*\" \"dist/src/js\"",
    "minify:html": "html-minifier --input-dir . --output-dir dist --file-ext html --collapse-whitespace --remove-comments --remove-redundant-attributes --remove-script-type-attributes --remove-tag-whitespace --use-short-doctype index.html pages/*.html",
    "minify:css": "cleancss -o dist/src/css/estilos-globais.min.css src/css/estilos-globais.css",
    "clean:maps": "rimraf dist/**/*.map",
    "build": "npm-run-all clean create-dirs copy:assets copy:js minify:html minify:css clean:maps"
  },
  "keywords": [
    "spotify-clone",
    "music-player",
    "kingdomfy",
    "html",
    "css",
    "javascript",
    "bootstrap"
  ],
  "author": "DomisDev",
  "license": "MIT",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "cpx": "^1.5.0",
    "html-minifier": "^4.0.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5"
  }
}